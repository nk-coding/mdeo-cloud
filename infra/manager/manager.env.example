# .env of the manager (next to docker-compose.manager.yaml). chmod 600.

# The manager image tag (ghcr.io/nk-coding/mdeo-manager:<tag>). The manager never updates itself:
# change this and run `docker compose -f docker-compose.manager.yaml up -d` to update it.
MANAGER_TAG=1.0.0
# Port of the manager page (plain HTTP, basic auth).
MANAGER_PORT=8090
#MANAGER_BIND=0.0.0.0

# Basic auth. The hash comes from
#   docker run --rm -i ghcr.io/nk-coding/mdeo-manager:<tag> hash-password
# (type the password, Enter). It contains no '$', so it needs no quoting.
MANAGER_USER=admin
MANAGER_PASSWORD_HASH=

# Versions the manager starts with when it has no state yet (later: the Versions form).
INITIAL_MDEO_TAG=1.0.0
INITIAL_SIM_TAG=0.2.0

# Rarely changed:
#STACK_PROJECT=mdeo                 # compose project name of the mdeo stack
#IMAGE_PREFIX=ghcr.io/nk-coding     # registry/owner of mdeo-* and palladio-sim-service
#HEALTH_TIMEOUT_SECONDS=600         # how long a change may take to become healthy before it is rolled back
#LB_IMAGE=haproxy:3.2.24-alpine     # load balancer in front of the simulator instances
#POSTGRES_IMAGE=postgres:17-alpine
#AUTO_HEAL=true                     # restart containers unhealthy for HEAL_GRACE_SECONDS (README: Auto-heal)
#HEAL_INTERVAL_SECONDS=30
#HEAL_GRACE_SECONDS=300
#HEAL_BACKOFF_BASE_SECONDS=60
#HEAL_BACKOFF_MAX_SECONDS=1800
