# Site settings and passwords of the mdeo stack the manager runs. Copy to stack.env next to
# docker-compose.manager.yaml, fill in, `chmod 600 stack.env`. The manager reads it on every
# action; it never writes it. Values are interpolated by docker compose: put a value with '$' in
# single quotes.

# --- required -----------------------------------------------------------------------------
# One password for all four databases (each database can also get its own, below). Choose it
# once: PostgreSQL stores it in its volume on first start, changing it here later breaks access.
DATABASE_PASSWORD=change-me
# The workbench's bootstrap administrator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# The host name (and :port, unless 80) users open the workbench at, comma-separated if several,
# e.g. mdeo.example.org or 203.0.113.7. No localhost in production.
CORS_ALLOWED_HOSTS=mdeo.example.org

# --- workbench ----------------------------------------------------------------------------
# Where the workbench (the only published port of the stack) listens on the host.
WORKBENCH_PORT=80
#WORKBENCH_BIND=0.0.0.0
# false for plain HTTP (the stack itself serves only HTTP); true when a TLS proxy fronts it.
COOKIE_SECURE=false
#COOKIE_SAMESITE=Strict

# --- optional -----------------------------------------------------------------------------
# Separate database credentials (default: user mdeo, DATABASE_PASSWORD).
#BACKEND_DB_PASSWORD=
#SCRIPT_DB_PASSWORD=
#MODEL_TRANSFORMATION_DB_PASSWORD=
#OPTIMIZER_DB_PASSWORD=
# JVM heaps (the optimizer's is set in the manager UI).
#BACKEND_HEAP=4g
#EXECUTION_HEAP=4g
# Must outlive the longest optimisation run, or a node cannot report its final state.
#JWT_EXECUTION_EXPIRATION_SECONDS=604800
#EXECUTION_TIMEOUT_MS=300000
#SCRIPT_TIMEOUT_MS=1000
#TRANSFORMATION_TIMEOUT_MS=1000
#MAX_LANGIUM_INSTANCES=5
#SESSION_MAX_IDLE_SECONDS=604800
#SESSION_MAX_ABSOLUTE_SECONDS=15552000
# Backend timeouts and the rest: see infra/.env.example and the deployment guide.
#
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY and SESSION_ENCRYPTION_KEY are generated by the manager into
# state/secrets.env on its first start; set them here only to use keys of your own.
