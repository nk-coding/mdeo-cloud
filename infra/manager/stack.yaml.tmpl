# GENERATED by mdeo-manager from its settings — do not edit; changes are overwritten.
#
# Settings: {{ .SettingsJSON }}
#
# Template: infra/manager/stack.yaml.tmpl. Secrets and site settings come from the env files the
# manager passes to every compose call (stack.env, written by the operator, and secrets.env,
# generated once by the manager).

x-logging: &logging
  driver: json-file
  options:
    max-size: "50m"
    max-file: "5"

x-jvm-env: &jvm-env
  # The JVM images are Alpine (musl), where this has no effect; it bounds glibc's malloc arenas
  # should they move to a glibc base.
  MALLOC_ARENA_MAX: "2"
  JWT_ISSUER: ${JWT_ISSUER:-mdeo-platform}
  SERVICE_CONNECT_TIMEOUT_SECONDS: ${SERVICE_CONNECT_TIMEOUT_SECONDS:-}

x-node-service: &node-service
  restart: unless-stopped
  logging: *logging
  healthcheck:
    test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://localhost:3000/"]
    interval: 10s
    timeout: 5s
    retries: 5
    start_period: 30s

x-postgres: &postgres
  image: {{ q .PostgresImage }}
  restart: unless-stopped
  logging: *logging
  # A clean shutdown, so a restart never needs crash recovery.
  stop_grace_period: 60s
  healthcheck:
    test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d mdeo"]
    interval: 10s
    timeout: 5s
    retries: 5
    start_period: 30s

services:
  postgres-backend:
    <<: *postgres
    environment:
      POSTGRES_USER: ${BACKEND_DB_USER:-mdeo}
      POSTGRES_PASSWORD: ${BACKEND_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      POSTGRES_DB: mdeo
    volumes:
      - postgres-backend-data:/var/lib/postgresql/data

  postgres-script:
    <<: *postgres
    environment:
      POSTGRES_USER: ${SCRIPT_DB_USER:-mdeo}
      POSTGRES_PASSWORD: ${SCRIPT_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      POSTGRES_DB: mdeo
    volumes:
      - postgres-script-data:/var/lib/postgresql/data

  postgres-model-transformation:
    <<: *postgres
    environment:
      POSTGRES_USER: ${MODEL_TRANSFORMATION_DB_USER:-mdeo}
      POSTGRES_PASSWORD: ${MODEL_TRANSFORMATION_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      POSTGRES_DB: mdeo
    volumes:
      - postgres-model-transformation-data:/var/lib/postgresql/data

  postgres-optimizer:
    <<: *postgres
    # Every optimizer node keeps a pool of up to DATABASE_MAX_POOL_SIZE (10) connections.
    command: ["postgres", "-c", "max_connections={{ .OptimizerDBConnections }}"]
    environment:
      POSTGRES_USER: ${OPTIMIZER_DB_USER:-mdeo}
      POSTGRES_PASSWORD: ${OPTIMIZER_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      POSTGRES_DB: mdeo
    volumes:
      - postgres-optimizer-data:/var/lib/postgresql/data

  backend:
    image: {{ q (.Image "backend") }}
    restart: unless-stopped
    logging: *logging
    environment:
      <<: *jvm-env
      JAVA_TOOL_OPTIONS: "-Xmx${BACKEND_HEAP:-4g} -XX:+ExitOnOutOfMemoryError"
      ENVIRONMENT: ${ENVIRONMENT:-production}
      DATABASE_URL: jdbc:postgresql://postgres-backend:5432/mdeo
      DATABASE_USER: ${BACKEND_DB_USER:-mdeo}
      DATABASE_PASSWORD: ${BACKEND_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      # Every HTTP request arrives through the workbench nginx (see plugins/ClientAddress.kt).
      TRUSTED_PROXY_HOPS: ${TRUSTED_PROXY_HOPS:-1}
      GIT_SSH_PORT: "2222"
      GIT_OAUTH_AUTHORIZE_PATH: /oauth/authorize
      GIT_OAUTH_TOKEN_PATH: /api/oauth/token
      # Only the workbench's HTTP port is published, so there is no SSH endpoint to advertise.
      GIT_SSH_PUBLICLY_REACHABLE: "false"
      SESSION_MAX_IDLE_SECONDS: ${SESSION_MAX_IDLE_SECONDS:-604800}
      SESSION_MAX_ABSOLUTE_SECONDS: ${SESSION_MAX_ABSOLUTE_SECONDS:-15552000}
      SESSION_ENCRYPTION_KEY: ${SESSION_ENCRYPTION_KEY:?missing SESSION_ENCRYPTION_KEY (secrets.env)}
      JWT_PRIVATE_KEY: ${JWT_PRIVATE_KEY:?missing JWT_PRIVATE_KEY (secrets.env)}
      JWT_PUBLIC_KEY: ${JWT_PUBLIC_KEY:?missing JWT_PUBLIC_KEY (secrets.env)}
      JWT_EXPIRATION_SECONDS: ${JWT_EXPIRATION_SECONDS:-3600}
      JWT_EXECUTION_EXPIRATION_SECONDS: ${JWT_EXECUTION_EXPIRATION_SECONDS:-604800}
      FILE_DATA_COMPUTATION_TIMEOUT_SECONDS: ${FILE_DATA_COMPUTATION_TIMEOUT_SECONDS:-}
      FILE_DATA_COMPUTATION_BINDING_SECONDS: ${FILE_DATA_COMPUTATION_BINDING_SECONDS:-}
      PLUGIN_REQUEST_TIMEOUT_SECONDS: ${PLUGIN_REQUEST_TIMEOUT_SECONDS:-}
      EXECUTION_START_TIMEOUT_SECONDS: ${EXECUTION_START_TIMEOUT_SECONDS:-}
      EXECUTION_READ_TIMEOUT_SECONDS: ${EXECUTION_READ_TIMEOUT_SECONDS:-}
      PLUGIN_MANIFEST_CHECK_SECONDS: ${PLUGIN_MANIFEST_CHECK_SECONDS:-}
      PLUGIN_MANIFEST_REFRESH_COOLDOWN_SECONDS: ${PLUGIN_MANIFEST_REFRESH_COOLDOWN_SECONDS:-}
      PLUGIN_MANIFEST_TIMEOUT_SECONDS: ${PLUGIN_MANIFEST_TIMEOUT_SECONDS:-}
      FILE_DATA_BATCH_CONCURRENCY: ${FILE_DATA_BATCH_CONCURRENCY:-}
      COOKIE_SECURE: ${COOKIE_SECURE:-false}
      COOKIE_SAMESITE: ${COOKIE_SAMESITE:-Strict}
      CORS_ALLOWED_HOSTS: ${CORS_ALLOWED_HOSTS:?set CORS_ALLOWED_HOSTS in stack.env}
      ADMIN_USERNAME: ${ADMIN_USERNAME:-admin}
      ADMIN_PASSWORD: ${ADMIN_PASSWORD:?set ADMIN_PASSWORD in stack.env}
      # Plugin URLs are same-origin paths: the browser resolves them against the workbench's host,
      # the backend prefixes them with INTERNAL_PLUGIN_BASE_URL (as infra/docker-compose.yaml and
      # infra/k8s do).
      PLUGIN_BASE_URL: ""
      INTERNAL_PLUGIN_BASE_URL: http://workbench:80
      DEFAULT_PLUGIN_URLS: /plugin/metamodel,/plugin/model,/plugin/script,/plugin/model-transformation,/plugin/config,/plugin/config-optimization,/plugin/config-mdeo,/plugin/csv,/plugin/model-csv
    depends_on:
      postgres-backend:
        condition: service_healthy
      workbench:
        condition: service_started
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s

  workbench:
    image: {{ q (.Image "workbench") }}
    restart: unless-stopped
    logging: *logging
    environment:
      PLUGIN_METAMODEL_SERVICE: http://service-metamodel:3000
      PLUGIN_MODEL_SERVICE: http://service-model:3000
      PLUGIN_SCRIPT_SERVICE: http://service-script:3000
      PLUGIN_MODEL_TRANSFORMATION_SERVICE: http://service-model-transformation:3000
      PLUGIN_CONFIG_SERVICE: http://service-config:3000
      PLUGIN_CONFIG_OPTIMIZATION_SERVICE: http://service-config-optimization:3000
      PLUGIN_CONFIG_MDEO_SERVICE: http://service-config-mdeo:3000
      PLUGIN_CSV_SERVICE: http://service-csv:3000
      PLUGIN_MODEL_CSV_SERVICE: http://service-model-csv:3000
      BACKEND_SERVICE: http://backend:8080
    ports:
      - "${WORKBENCH_BIND:-0.0.0.0}:${WORKBENCH_PORT:-80}:80"
    depends_on:
      service-metamodel:
        condition: service_healthy
      service-model:
        condition: service_healthy
      service-script:
        condition: service_healthy
      service-model-transformation:
        condition: service_healthy
      service-config:
        condition: service_healthy
      service-config-optimization:
        condition: service_healthy
      service-config-mdeo:
        condition: service_healthy
      service-csv:
        condition: service_healthy
      service-model-csv:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:80/"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
{{ range .PluginServices }}
  {{ .Name }}:
    <<: *node-service
    image: {{ q ($.Image .Name) }}
    environment:
      PORT: "3000"
      HOST: 0.0.0.0
      BACKEND_API_URL: http://backend:8080/api
      MAX_LANGIUM_INSTANCES: ${MAX_LANGIUM_INSTANCES:-5}
{{- range .Env }}
      {{ .Key }}: {{ q .Value }}
{{- end }}
{{ end }}
  script-execution:
    image: {{ q (.Image "script-execution") }}
    restart: unless-stopped
    logging: *logging
    environment:
      <<: *jvm-env
      JAVA_TOOL_OPTIONS: "-Xmx${EXECUTION_HEAP:-4g} -XX:+ExitOnOutOfMemoryError"
      SERVER_PORT: "8080"
      DATABASE_URL: jdbc:postgresql://postgres-script:5432/mdeo
      DATABASE_USER: ${SCRIPT_DB_USER:-mdeo}
      DATABASE_PASSWORD: ${SCRIPT_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      BACKEND_API_URL: http://backend:8080
      EXECUTION_TIMEOUT_MS: ${EXECUTION_TIMEOUT_MS:-300000}
    depends_on:
      postgres-script:
        condition: service_healthy
      backend:
        condition: service_started
    healthcheck: &jvm-health
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 40s

  model-transformation-execution:
    image: {{ q (.Image "model-transformation-execution") }}
    restart: unless-stopped
    logging: *logging
    environment:
      <<: *jvm-env
      JAVA_TOOL_OPTIONS: "-Xmx${EXECUTION_HEAP:-4g} -XX:+ExitOnOutOfMemoryError"
      SERVER_PORT: "8080"
      DATABASE_URL: jdbc:postgresql://postgres-model-transformation:5432/mdeo
      DATABASE_USER: ${MODEL_TRANSFORMATION_DB_USER:-mdeo}
      DATABASE_PASSWORD: ${MODEL_TRANSFORMATION_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      BACKEND_API_URL: http://backend:8080
      EXECUTION_TIMEOUT_MS: ${EXECUTION_TIMEOUT_MS:-300000}
    depends_on:
      postgres-model-transformation:
        condition: service_healthy
      backend:
        condition: service_started
    healthcheck: *jvm-health
{{ range .Optimizers }}
  {{ .Name }}:
    image: {{ q ($.Image "optimizer-execution") }}
    restart: unless-stopped
    logging: *logging
{{- if .CPUSet }}
    # NUMA node {{ .NumaNode }}
    cpuset: {{ q .CPUSet }}
{{- end }}
    # Under memory pressure the kernel kills workers before the databases and the backend.
    oom_score_adj: 500
    ulimits:
      nofile: {soft: 65536, hard: 65536}
    environment:
      <<: *jvm-env
      # Inherited by the worker subprocess every run starts, which does the actual work.
      JAVA_TOOL_OPTIONS: {{ q $.OptimizerJavaOptions }}
      SERVER_PORT: "8080"
      DATABASE_URL: jdbc:postgresql://postgres-optimizer:5432/mdeo
      DATABASE_USER: ${OPTIMIZER_DB_USER:-mdeo}
      DATABASE_PASSWORD: ${OPTIMIZER_DB_PASSWORD:-${DATABASE_PASSWORD:?set DATABASE_PASSWORD in stack.env}}
      BACKEND_API_URL: http://backend:8080
      SCRIPT_TIMEOUT_MS: ${SCRIPT_TIMEOUT_MS:-1000}
      TRANSFORMATION_TIMEOUT_MS: ${TRANSFORMATION_TIMEOUT_MS:-1000}
      NODE_ID: {{ q .ID }}
      NODE_URL: {{ q .URL }}
      PEERS: {{ q .Peers }}
      WORKER_THREADS: {{ q $.S.OptimizerThreads }}
    depends_on:
      postgres-optimizer:
        condition: service_healthy
      backend:
        condition: service_started
    healthcheck: *jvm-health
{{ end }}
{{- range .Sims }}
  {{ .Name }}:
    image: {{ q $.SimImage }}
    restart: unless-stopped
    logging: *logging
    # tini as PID 1, so the stop signal reaches the service.
    init: true
    stop_grace_period: 10s
{{- if .CPUSet }}
    # NUMA node {{ .NumaNode }}
    cpuset: {{ q .CPUSet }}
{{- end }}
    oom_score_adj: 500
    ulimits:
      nofile: {soft: 65536, hard: 65536}
    environment:
      PORT: "3022"
      HOST: 0.0.0.0
      BACKEND_API_URL: http://backend:8080/api
      JWT_ISSUER: ${JWT_ISSUER:-mdeo-platform}
      SIM_THREADS: {{ q $.S.SimThreads }}
      MAX_SESSIONS: {{ q $.S.SimMaxSessions }}
      SIM_RESULT_CACHE_SIZE: {{ q $.S.SimResultCacheSize }}
      PCM_CACHE_MB: {{ q $.S.SimCacheMB }}
      SIM_TIMEOUT_SECONDS: {{ q $.S.SimTimeoutSeconds }}
      RUST_LOG: ${SIM_RUST_LOG:-info}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:3022/"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
{{ end }}
  # The one address the Palladio Simulation plugin is registered under in mdeo
  # (http://palladio-sim:3022/). Every script session is one WebSocket, so balancing connections
  # (least connections first) spreads sessions over the instances; health checks take an
  # instance out while it restarts.
  palladio-sim:
    image: {{ q .LBImage }}
    restart: unless-stopped
    logging: *logging
    labels:
      # Changes with the configuration, so compose recreates the container when it changes.
      org.mdeo.manager.lb-config-sha256: {{ q .LBConfigHash }}
    ulimits:
      nofile: {soft: 65536, hard: 65536}
    configs:
      - source: palladio-sim-lb
        target: /usr/local/etc/haproxy/haproxy.cfg
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8405/healthz"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

configs:
  palladio-sim-lb:
    content: |
{{ indent 6 .LBConfig }}
volumes:
  postgres-backend-data:
  postgres-script-data:
  postgres-model-transformation-data:
  postgres-optimizer-data:
